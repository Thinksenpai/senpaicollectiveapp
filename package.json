    "deploy": "npm run build && wrangler pages deploy dist --project-name senpai-collective-app",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name senpai-collective-app --env production"
  },
  "dependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.1.4",
    "wrangler": "^4.54.0"
  }
}
